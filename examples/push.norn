// Keep going until a judged condition holds. Each attempt is its own request, named by its number.
let rec push = attempt => {
  let report = run(@claude, "Move #1439 forward until it is merged and verified live", ~key=`move ${attempt->show}`)->wait?
  if judge("merged and verified live", ~key=`judge ${attempt->show}`, ~about=report)->wait? {
    Answered(report)
  } else {
    prActivity("acme/api#1439")->or(after(2h))->wait
    push(attempt + 1)
  }
}
push(1)?
