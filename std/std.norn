// The standard library, written in Norn and opened with `open Std` (spec §8).

let remind = (who, text, ~at) => {
  after(at)->wait
  ask(who, text)->wait
}

let decide = (who, question, ~options, ~recommend, ~by) =>
  switch choose(who, `${question}\nRecommended: ${recommend->show}. No answer by ${by->show} means the recommendation.`, options, ~by)->wait {
  | Answered(choice) => choice
  | NoReply => recommend             // the declared default, and only when nobody replied in time
  | other => fail(other)
  }

let followUp = (who, text, ~within, ~escalateTo) => {
  let q = ask(who, text)
  switch q->waitUntil(within) {
  | Some(reply) => reply
  | None => q->handOver(escalateTo)->wait
  }
}

let schedule = (~key="schedule", ~every as period, ~on=never(), task) =>
  every(period)->or(on)->forEach(~key, _ => run(@auto, task)->wait)

// Work that repeats: a round every period counted from a time, and at once when `on` occurs. `who` does it; when
// that does not end in an answer, `otherwise` is asked the same once, and a round that still fails is reported.
let routine = (~key="routine", ~every as period, ~from, ~on=never(), ~who=@auto, ~otherwise, ~by=8h, task) =>
  every(period, ~from)->or(on)->forEach(~key, _ =>
    switch run(who, task, ~by)->wait {
    | Answered(report) => Answered(report)
    | _ => run(otherwise, task, ~by)->wait
    })

let digest = (who, ~every as period) =>
  schedule(~every=period, `Tell ${who->show} what changed since they last looked; say nothing if nothing changed`)

// Every reply, in the order the requests were given. The requests were made before this is called, so they are open together.
let rec all = requests =>
  switch requests {
  | [] => []
  | [request, ...rest] =>
    let reply = request->wait
    [reply, ...all(rest)]
  }

// Cancels every still-open request in the list (already-settled requests are left untouched).
let rec cancelAll = requests =>
  switch requests {
  | [] => ()
  | [request, ...rest] =>
    cancel(request)
    cancelAll(rest)
  }

// Waits for every request to settle without short-circuiting on failures, returning all replies in order.
let allSettled = requests => all(requests)

// Waits for the first request to settle and cancels the remaining open requests.
let race = requests => {
  let (winner, reply) = first(requests)
  cancelAll(requests)
  (winner, reply)
}

let rec partitionOpen = (requests, answers) =>
  switch requests {
  | [] => ([], answers)
  | [request, ...rest] =>
    let (openReqs, acc) = partitionOpen(rest, answers)
    switch status(request) {
    | None => ([request, ...openReqs], acc)
    | Some(Answered(v)) => (openReqs, [v, ...acc])
    | Some(_) => (openReqs, acc)
    }
  }

let rec hasAtLeast = (items, n) =>
  if n <= 0 { true }
  else {
    switch items {
    | [] => false
    | [_, ...rest] => hasAtLeast(rest, n - 1)
    }
  }

let rec quorumLoop = (requests, needed, answers) => {
  let (openReqs, nextAnswers) = partitionOpen(requests, answers)
  if hasAtLeast(nextAnswers, needed) {
    cancelAll(openReqs)
    nextAnswers
  } else {
    switch openReqs {
    | [] => nextAnswers
    | _ =>
      let (winner, reply) = first(openReqs)
      cancel(winner)
      ignore(reply)
      quorumLoop(openReqs, needed, nextAnswers)
    }
  }
}

// Waits until `~needed` requests return `Answered`, then cancels the remaining open requests and returns the collected answers.
let quorum = (requests, ~needed) => quorumLoop(requests, needed, [])

// Heterogeneous stream alternation returning `stream<either<'a, 'b>>` (alias for `or`, alongside homogeneous `merge`).
let orEither = (a, b) => or(a, b)

// One branch for each thing that has a `kind`, for as long as it has it. A branch begins when the thing
// starts having the kind and ends, cancelling what it left open, when it stops; the other branches go on.
// `branch` gets what holds for its thing and reads it with `Holds.sample`, so a changed value reaches the
// branch's next round without interrupting the one at work.
let each = (~key="each", kind, branch) =>
  Holds.members(kind)->forEach(~key, ~each=Together, ~per=m => m.id, m =>
    if m.present { branch(Holds.held(kind, m.id)) } else { () })
